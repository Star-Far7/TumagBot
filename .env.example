# ── Обязательные ──────────────────────────────────────────
BOT_TOKEN=123456:ABC-DEF...
GEMINI_API_KEY=AIza...

# ── Опциональные ──────────────────────────────────────────
# Модель Gemini (по умолчанию gemini-2.0-flash-lite)
# GEMINI_MODEL=gemini-2.0-flash-lite

# Путь к SQLite базе (по умолчанию data/umag_bot.db)
# DATABASE_PATH=data/umag_bot.db

# Уровень логирования: DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO

# Файл логов
# LOG_FILE=logs/bot.log

# Ограничить доступ (ID через запятую, пусто = все)
# ALLOWED_USERS=123456789,987654321

# Пороги нечёткого поиска
# AUTO_MATCH_THRESHOLD=0.82
# SUGGEST_THRESHOLD=0.40
# MAX_SUGGESTIONS=5

# ── Umag API (для прямой загрузки приёмок) ────────────────
# Логин и пароль от web.umag.kz
# UMAG_LOGIN=your@email.com
# UMAG_PASSWORD=yourpassword
# ID магазина (видно в localStorage как storeId после входа в web.umag.kz)
# UMAG_STORE_ID=55963
